		sourceColumn: rate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column unit
		dataType: string
		lineageTag: d1ec33d8-43b7-4c2d-a0bb-4f20bb19da22
		summarizeBy: none
